#!/usr/bin/env bash
# Run a selected OmarKEYS row after the overlay closes.
#
# Two modes, because there are two kinds of row:
#
#   run-shortcut --dispatch <kind> <arg> [window]
#       An Omarchy/Hyprland bind. Runs the binding's own action. Replaying
#       the chord as a synthetic key does NOT work: keys sent to a window
#       never reach Hyprland's bind matcher, so the app just swallows them
#       and the binding never fires. Same dispatch path Omarchy's own
#       omarchy-menu-keybindings uses.
#
#   run-shortcut --focus <window>
#       Raise a window, for double-clicking an app in the tree. Hyprland's
#       classic `focuswindow address:0x...` no longer parses - hyprctl reads
#       dispatch arguments as Lua - so this goes through hl.dsp.focus.
#
#   run-shortcut <mods> <key> [window]
#       An app sheet row (Chromium, Ghostty, ...). These are the app's own
#       shortcuts, not Hyprland binds, so sending the keys to a window is
#       exactly right.
#
# [window] is a Hyprland window selector, normally address:0x... for the
# window that was focused before the overlay opened. Keys go there rather
# than to whatever is active by the time we run, which matters because the
# overlay has just closed and focus may not have settled. Defaults to
# activewindow when omitted or when the window is gone.
set -euo pipefail

lua_string() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

dispatch_lua() {
  local expression="$1"
  local output
  output=$(hyprctl dispatch "$expression" 2>&1) || return 1
  [[ -z $output || $output == ok ]]
}

send_keys() {
  local mods="$1" key="$2" window="${3:-activewindow}"
  [[ -n $key ]] || return 1
  local mods_lua key_lua window_lua
  mods_lua=$(lua_string "$mods")
  key_lua=$(lua_string "$key")
  window_lua=$(lua_string "$window")
  if dispatch_lua "hl.dsp.send_key_state({ mods = ${mods_lua}, key = ${key_lua}, state = \"down\", window = ${window_lua} })"; then
    sleep 0.05
    dispatch_lua "hl.dsp.send_key_state({ mods = ${mods_lua}, key = ${key_lua}, state = \"up\", window = ${window_lua} })" || true
    return 0
  fi
  hyprctl dispatch sendshortcut "${mods},${key}," >/dev/null
}

# Only send to the remembered window if it still exists; a stale address
# would silently swallow the keystroke.
window_or_active() {
  local want="$1"
  [[ -n $want ]] || { echo "activewindow"; return; }
  local addr="${want#address:}"
  if hyprctl -j clients 2>/dev/null | python3 -c '
import json, sys
want = sys.argv[1].removeprefix("address:")
try:
    clients = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for c in clients:
    addr = str(c.get("address") or "").removeprefix("address:")
    if addr == want:
        sys.exit(0)
sys.exit(1)
' "$addr"; then
    echo "$want"
  else
    echo "activewindow"
  fi
}

dispatch_binding() {
  local kind="$1" arg="$2" fallback_window="$3"
  case "$kind" in
    exec)
      [[ -n $arg ]] || return 1
      dispatch_lua "hl.dsp.exec_cmd($(lua_string "$arg"))" || hyprctl dispatch exec "$arg" >/dev/null
      ;;
    lua)
      # arg is already a hl.dsp.* call expression.
      [[ -n $arg ]] || return 1
      hyprctl dispatch "$arg" >/dev/null
      ;;
    sendshortcut)
      # Hyprland's own "forward this chord to a window" bind.
      local mods key window rest
      IFS=, read -r mods key window rest <<<"$arg"
      # An explicit window in the bind wins; otherwise aim at the window
      # the overlay was opened from.
      [[ -n $window ]] || window=$(window_or_active "$fallback_window")
      send_keys "${mods// /}" "$key" "${window:-activewindow}"
      ;;
    "")
      return 1
      ;;
    *)
      if [[ -n $arg ]]; then
        hyprctl dispatch "$kind" "$arg" >/dev/null
      else
        hyprctl dispatch "$kind" >/dev/null
      fi
      ;;
  esac
}

if [[ ${1-} == "--focus" ]]; then
  target="${2-}"
  [[ -n $target ]] || exit 1
  dispatch_lua "hl.dsp.focus({ window = $(lua_string "$target") })"
  exit $?
fi

if [[ ${1-} == "--dispatch" ]]; then
  dispatch_binding "${2-}" "${3-}" "${4-}"
  exit $?
fi

mods="${1-}"
key="${2-}"
[[ -n $key ]] || exit 1
send_keys "$mods" "$key" "$(window_or_active "${3-}")"
