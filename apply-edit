#!/usr/bin/env python3
"""Persist OmarKEYS chord remaps as Hyprland user-config overrides.

Edits live in ~/.config/hypr/omarkeys-edits.lua, which install.sh dofiles from
bindings.lua. Chord history lives in ~/.config/omarchy/omarkeys-chords.json:

    defaults  factory keys per action (seeded once from the live dump)
    moves     remap log used to unwind a change and any displaced chain

Before each write, snapshots land in ~/.local/state/omarchy/omarkeys-history
(a git repo). A successful hyprctl reload is committed; a failed reload
restores the previous commit.

apply-edit never writes plugin git origin or Omarchy default bind modules.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path(os.environ.get("HOME", ""))
HYPR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "hypr"
BINDINGS_LUA = HYPR / "bindings.lua"
EDITS_LUA = HYPR / "omarkeys-edits.lua"
CHORD_INDEX = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "omarchy" / "omarkeys-chords.json"
HISTORY = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "omarchy" / "omarkeys-history"
GIT_ENV = {
    **os.environ,
    "GIT_AUTHOR_NAME": "OmarKEYS",
    "GIT_AUTHOR_EMAIL": "omarkeys@local",
    "GIT_COMMITTER_NAME": "OmarKEYS",
    "GIT_COMMITTER_EMAIL": "omarkeys@local",
}

LUA_HEADER = """-- OmarKEYS chord overrides. Generated by apply-edit; do not edit by hand.
-- Official Omarchy override style: hl.unbind then bind. This file is
-- dofile'd from bindings.lua so we never rewrite Omarchy defaults or
-- the body of bindings.lua. Each working version is also git-committed
-- under ~/.local/state/omarchy/omarkeys-history.

"""


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def die(msg: str, code: int = 1) -> None:
    log(msg)
    raise SystemExit(code)


def lua_string(value: str) -> str:
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'


def is_chord(value: str) -> bool:
    return bool(re.fullmatch(r"[A-Za-z0-9_ +./-]+", value or "")) and 0 < len(value) < 80


def is_protected_chord(keys: str) -> bool:
    """OmarKEYS' own summons cannot be remapped from the overlay."""
    text = str(keys or "").strip()
    if re.fullmatch(r"SUPER\s*\+\s*K", text, re.I):
        return True
    if re.fullmatch(r"Super\s*\+\s*K", text):
        return True
    if re.search(r"double-tap|hold super", text, re.I):
        return True
    return False


def to_bind_keys(keys: str) -> str:
    """Turn overlay 'Super + Return' into Omarchy bind 'SUPER + RETURN'."""
    parts = [p.strip() for p in re.split(r"\s*\+\s*", str(keys or "")) if p.strip()]
    have: dict[str, bool] = {}
    key = ""
    for part in parts:
        up = part.upper()
        if up in ("SUPER", "META", "WIN"):
            have["SUPER"] = True
        elif up == "SHIFT":
            have["SHIFT"] = True
        elif up in ("CTRL", "CONTROL"):
            have["CTRL"] = True
        elif up == "ALT":
            have["ALT"] = True
        else:
            key = up
    out = [mod for mod in ("SUPER", "SHIFT", "CTRL", "ALT") if have.get(mod)]
    if key:
        out.append(key)
    return " + ".join(out)


def lua_dispatcher(kind: str, arg: str) -> str | None:
    """Rebuild the bind's action. Chord remap only — never invent a command."""
    kind = (kind or "").strip()
    arg = arg or ""
    if "\n" in arg or "\r" in arg:
        return None
    if kind == "exec":
        if not arg.strip():
            return None
        return f"hl.dsp.exec_cmd({lua_string(arg)})"
    if kind == "lua":
        if re.fullmatch(r"hl\.dsp\.[A-Za-z0-9_.]+\(.*\)$", arg):
            return arg
        return None
    return None


def bind_stanza(
    old_keys: str,
    old_action: str,
    new_keys: str,
    action: str,
    kind: str,
    arg: str,
) -> str:
    disp = lua_dispatcher(kind, arg)
    if not disp:
        raise ValueError("cannot remap without a recovered dispatcher")
    old_bind = to_bind_keys(old_keys)
    new_bind = to_bind_keys(new_keys)
    return (
        f"-- {dt.datetime.now().isoformat(timespec='seconds')}: "
        f"{old_bind} ({old_action}) -> {new_bind} ({action})\n"
        f"hl.unbind({lua_string(old_bind)})\n"
        f"hl.bind({lua_string(new_bind)}, {disp}, {{ description = {lua_string(action)} }})\n\n"
    )


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=False, text=True, capture_output=True, **kwargs)


def git(*args: str) -> subprocess.CompletedProcess:
    return run(["git", "-C", str(HISTORY), *args], env=GIT_ENV)


def ensure_history() -> None:
    HISTORY.mkdir(parents=True, exist_ok=True)
    if not (HISTORY / ".git").exists():
        git("init")
        git("commit", "--allow-empty", "-m", "OmarKEYS keymap history")


def snapshot_into_history() -> None:
    ensure_history()
    for src in (BINDINGS_LUA, EDITS_LUA):
        if src.exists():
            shutil.copy2(src, HISTORY / src.name)
    if CHORD_INDEX.exists():
        shutil.copy2(CHORD_INDEX, HISTORY / "omarkeys-chords.json")


def commit_history(message: str) -> None:
    snapshot_into_history()
    git("add", "-A")
    status = git("status", "--porcelain")
    if not (status.stdout or "").strip():
        return
    git("commit", "-m", message)


def restore_last_commit() -> None:
    git("checkout", "--", ".")
    for name, dest in (
        ("bindings.lua", BINDINGS_LUA),
        ("omarkeys-edits.lua", EDITS_LUA),
        ("omarkeys-chords.json", CHORD_INDEX),
    ):
        src = HISTORY / name
        if src.exists():
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest)


def ensure_edits_wired() -> None:
    if not BINDINGS_LUA.exists():
        raise SystemExit(f"missing {BINDINGS_LUA}")
    marker = "-- OmarKEYS edits"
    line = 'dofile((os.getenv("HOME") or "") .. "/.config/hypr/omarkeys-edits.lua")'
    text = BINDINGS_LUA.read_text()
    if "omarkeys-edits.lua" in text:
        return
    stamp = dt.datetime.now().strftime("%Y%m%d%H%M%S")
    shutil.copy2(BINDINGS_LUA, BINDINGS_LUA.with_suffix(f".lua.bak.{stamp}"))
    if not text.endswith("\n"):
        text += "\n"
    BINDINGS_LUA.write_text(text + f"\n{marker}\n{line}\n")


def ensure_edits_file() -> None:
    EDITS_LUA.parent.mkdir(parents=True, exist_ok=True)
    if not EDITS_LUA.exists():
        EDITS_LUA.write_text(LUA_HEADER, encoding="utf-8")


def reload_hypr() -> str:
    if os.environ.get("OMARKEYS_SKIP_RELOAD") == "1":
        return ""
    hyprctl = shutil.which("hyprctl")
    if not hyprctl:
        log("hyprctl not on PATH; wrote edits without reload")
        return ""
    run([hyprctl, "reload"])
    err = run([hyprctl, "configerrors"])
    return (err.stdout or "").strip()


def load_index() -> dict:
    if not CHORD_INDEX.exists():
        return {"defaults": {}, "moves": []}
    try:
        data = json.loads(CHORD_INDEX.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {"defaults": {}, "moves": []}
    if not isinstance(data, dict):
        return {"defaults": {}, "moves": []}
    data.setdefault("defaults", {})
    data.setdefault("moves", [])
    if not isinstance(data["defaults"], dict):
        data["defaults"] = {}
    if not isinstance(data["moves"], list):
        data["moves"] = []
    return data


def save_index(data: dict) -> None:
    CHORD_INDEX.parent.mkdir(parents=True, exist_ok=True)
    tmp = CHORD_INDEX.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    tmp.replace(CHORD_INDEX)


def seed_defaults(entries: list[dict]) -> dict:
    data = load_index()
    defaults = data["defaults"]
    added = 0
    for entry in entries:
        action = str(entry.get("action") or "").strip()
        keys = str(entry.get("keys") or "").strip()
        if not action or not keys:
            continue
        if action in defaults:
            continue
        defaults[action] = {
            "keys": keys,
            "dispatcher": str(entry.get("dispatcher") or ""),
            "arg": str(entry.get("arg") or ""),
        }
        added += 1
    save_index(data)
    return {"ok": True, "added": added, "total": len(defaults)}


def current_state(data: dict) -> dict[str, dict]:
    current: dict[str, dict] = {}
    for action, meta in data["defaults"].items():
        if not isinstance(meta, dict):
            continue
        current[action] = {
            "keys": str(meta.get("keys") or ""),
            "dispatcher": str(meta.get("dispatcher") or ""),
            "arg": str(meta.get("arg") or ""),
        }
    for move in data["moves"]:
        if not isinstance(move, dict):
            continue
        action = str(move.get("action") or "").strip()
        if action not in current:
            continue
        current[action]["keys"] = str(move.get("to") or current[action]["keys"])
        if move.get("dispatcher"):
            current[action]["dispatcher"] = str(move.get("dispatcher"))
        if "arg" in move and move.get("arg") is not None:
            current[action]["arg"] = str(move.get("arg"))
    return current


def remapped_actions(data: dict) -> dict[str, dict]:
    current = current_state(data)
    out: dict[str, dict] = {}
    for action, meta in current.items():
        factory = data["defaults"].get(action) or {}
        factory_keys = str(factory.get("keys") or "") if isinstance(factory, dict) else ""
        if to_bind_keys(meta["keys"]) != to_bind_keys(factory_keys):
            out[action] = meta
    return out


def index_json() -> dict:
    data = load_index()
    current = {action: meta["keys"] for action, meta in current_state(data).items()}
    remapped = {action: meta["keys"] for action, meta in remapped_actions(data).items()}
    return {
        "ok": True,
        "defaults": data["defaults"],
        "moves": data["moves"],
        "current": current,
        "remapped": remapped,
    }


def related_actions(action: str, moves: list) -> set[str]:
    related = {action}
    changed = True
    while changed:
        changed = False
        for move in moves:
            if not isinstance(move, dict):
                continue
            name = str(move.get("action") or "")
            because = str(move.get("because") or "")
            if name in related or (because and because in related):
                if name and name not in related:
                    related.add(name)
                    changed = True
                if because and because not in related:
                    related.add(because)
                    changed = True
    return related


def restore_plan(action: str, data: dict) -> list[dict]:
    related = related_actions(action, data["moves"])
    current = current_state(data)
    steps = []
    for name in sorted(related):
        factory = data["defaults"].get(name)
        meta = current.get(name)
        if not isinstance(factory, dict) or not meta:
            continue
        factory_keys = str(factory.get("keys") or "")
        if to_bind_keys(meta["keys"]) == to_bind_keys(factory_keys):
            continue
        steps.append(
            {
                "action": name,
                "old_keys": meta["keys"],
                "new_keys": factory_keys,
                "dispatcher": str(factory.get("dispatcher") or meta.get("dispatcher") or ""),
                "arg": factory["arg"] if "arg" in factory else meta.get("arg", ""),
                "because": "",
            }
        )
    return steps


def emit_overrides(data: dict) -> str:
    remapped = remapped_actions(data)
    chunks = [LUA_HEADER]
    seen: set[str] = set()
    unbinds: list[str] = []
    for action, meta in remapped.items():
        factory = data["defaults"].get(action) or {}
        factory_keys = str(factory.get("keys") or "") if isinstance(factory, dict) else ""
        for keys in (factory_keys, meta.get("keys")):
            chord = to_bind_keys(keys or "")
            if chord and chord not in seen:
                seen.add(chord)
                unbinds.append(chord)
    for chord in unbinds:
        chunks.append(f"hl.unbind({lua_string(chord)})\n")
    if remapped:
        chunks.append("\n")
    for action, meta in remapped.items():
        disp = lua_dispatcher(meta["dispatcher"], meta.get("arg") or "")
        if not disp:
            raise ValueError(f"cannot bind {action} without a recovered dispatcher")
        chunks.append(
            f"hl.bind({lua_string(to_bind_keys(meta['keys']))}, {disp}, "
            f"{{ description = {lua_string(action)} }})\n"
        )
    return "".join(chunks)


def write_edits_from_index(data: dict) -> None:
    ensure_edits_file()
    EDITS_LUA.write_text(emit_overrides(data), encoding="utf-8")


def validate_steps(steps: list[dict]) -> None:
    if not steps:
        die("empty plan")
    for step in steps:
        action = str(step.get("action") or "").strip()
        old_keys = str(step.get("old_keys") or "").strip()
        new_keys = str(step.get("new_keys") or "").strip()
        dispatcher = str(step.get("dispatcher") or "").strip()
        arg = str(step.get("arg") or "")
        if not action or "\n" in action:
            die("each apply step needs an action")
        if not is_chord(to_bind_keys(old_keys)) or not is_chord(to_bind_keys(new_keys)):
            die(f"refusing remap: keys must look like a Hyprland chord ({action})")
        if is_protected_chord(old_keys) or is_protected_chord(new_keys):
            die("refusing remap: Super+K / hold / double-tap stay OmarKEYS summons")
        if not lua_dispatcher(dispatcher, arg):
            die(f"cannot remap {action} without a recovered dispatcher")


def apply_plan(steps: list[dict], note: str) -> dict:
    validate_steps(steps)
    data = load_index()
    for step in steps:
        action = str(step.get("action") or "").strip()
        if action not in data["defaults"]:
            data["defaults"][action] = {
                "keys": str(step.get("old_keys") or ""),
                "dispatcher": str(step.get("dispatcher") or ""),
                "arg": str(step.get("arg") or ""),
            }
    trial = json.loads(json.dumps(data))
    for step in steps:
        trial["moves"].append(
            {
                "action": step.get("action"),
                "from": step.get("old_keys"),
                "to": step.get("new_keys"),
                "because": step.get("because") or "",
                "dispatcher": step.get("dispatcher") or "",
                "arg": step.get("arg") or "",
            }
        )
    emit_overrides(trial)
    ensure_history()
    commit_history("pre-edit snapshot")
    ensure_edits_wired()
    save_index(trial)
    write_edits_from_index(trial)
    errors = reload_hypr()
    if errors and errors.lower() not in ("ok", "no errors"):
        log(errors)
        restore_last_commit()
        reload_hypr()
        die("reload failed · restored previous version")
    commit_history(note or "apply chord remap")
    return {"ok": True, "steps": len(steps)}


def restore_default(action: str) -> dict:
    data = load_index()
    if action not in data["defaults"]:
        die(f"no stored default for {action}")
    related = related_actions(action, data["moves"])
    steps = restore_plan(action, data)
    trial = json.loads(json.dumps(data))
    trial["moves"] = [
        m for m in trial["moves"]
        if not (isinstance(m, dict) and (m.get("action") in related or m.get("because") in related))
    ]
    emit_overrides(trial)
    ensure_history()
    commit_history("pre-restore snapshot")
    ensure_edits_wired()
    save_index(trial)
    write_edits_from_index(trial)
    errors = reload_hypr()
    if errors and errors.lower() not in ("ok", "no errors"):
        log(errors)
        restore_last_commit()
        reload_hypr()
        die("reload failed · restored previous version")
    commit_history(f"restore default {action}")
    return {
        "ok": True,
        "steps": len(steps),
        "actions": sorted(related),
        "note": "already at default" if not steps else "",
    }


def cmd_history() -> None:
    ensure_history()
    out = git("log", "--oneline", "-20")
    sys.stdout.write(out.stdout or "")


def cmd_revert() -> None:
    ensure_history()
    log_out = git("log", "--oneline", "-2")
    lines = [ln for ln in (log_out.stdout or "").splitlines() if ln.strip()]
    if len(lines) < 2:
        die("no earlier version to revert to")
    git("revert", "--no-edit", "HEAD")
    restore_last_commit()
    errors = reload_hypr()
    if errors and errors.lower() not in ("ok", "no errors"):
        log(errors)
        die("revert failed")
    print(json.dumps({"ok": True}))


def read_json_arg(raw: str | None, path: str | None):
    if path:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    if raw:
        return json.loads(raw)
    if not sys.stdin.isatty():
        return json.loads(sys.stdin.read() or "{}")
    die("need --json or --file")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command",
        choices=(
            "wire", "seed", "index", "apply", "restore",
            "history", "list", "revert", "to-hypr",
        ),
    )
    parser.add_argument("--json", dest="json_text")
    parser.add_argument("--file")
    parser.add_argument("--action")
    parser.add_argument("--keys")
    args = parser.parse_args()

    if args.command == "wire":
        ensure_edits_wired()
        ensure_edits_file()
        print(json.dumps({"ok": True, "edits": str(EDITS_LUA)}))
        return
    if args.command == "seed":
        payload = read_json_arg(args.json_text, args.file)
        entries = payload if isinstance(payload, list) else payload.get("entries") or []
        print(json.dumps(seed_defaults(entries)))
        return
    if args.command == "index":
        print(json.dumps(index_json()))
        return
    if args.command == "apply":
        payload = read_json_arg(args.json_text, args.file)
        steps = payload if isinstance(payload, list) else payload.get("steps") or []
        note = str(payload.get("note") if isinstance(payload, dict) else "apply chord remap")
        print(json.dumps(apply_plan(steps, note)))
        return
    if args.command == "restore":
        if not args.action:
            die("--action is required")
        print(json.dumps(restore_default(args.action)))
        return
    if args.command in ("history", "list"):
        cmd_history()
        return
    if args.command == "revert":
        cmd_revert()
        return
    if args.command == "to-hypr":
        if not args.keys:
            die("--keys is required")
        print(to_bind_keys(args.keys))
        return
    die(f"unknown command {args.command}")


if __name__ == "__main__":
    main()
