def load_hypr_binds() -> dict[str, list[dict]]:
    try:
        raw = subprocess.check_output(["hyprctl", "-j", "binds"], text=True)
        binds = json.loads(raw)
    except (OSError, json.JSONDecodeError, subprocess.CalledProcessError):
        return {}
    by_desc: dict[str, list[dict]] = {}
    for bind in binds:
        desc = str(bind.get("description") or "").strip()
        key = str(bind.get("key") or "").strip()
        if not desc or not key or bind.get("mouse"):
            continue
        modmask = int(bind.get("modmask") or 0)
        mods = MODMASK_TEXT.get(modmask, "")
        by_desc.setdefault(desc, []).append(
            {"mods": mods, "bindKey": key, "modmask": modmask}
        )
    return by_desc


# Hyprland's Lua config provider reports every Lua-defined bind as
# dispatcher "__lua" with an opaque numeric arg (all 229 of Omarchy's
# binds, in practice), and "__lua" is not callable from hyprctl. So the
# real action has to come from the config itself: run it with a stubbed
# `hl` where bind() records instead of binding. Same approach Omarchy's
# own omarchy-menu-keybindings uses.
LUA_SCAN = r"""
local modifiers = { SHIFT = 1, CTRL = 4, CONTROL = 4, ALT = 8, SUPER = 64 }

local function split_keys(keys)
  local modmask, key = 0, ""
  for part in string.gmatch(tostring(keys or ""), "[^+]+") do
    local value = part:gsub("^%s+", ""):gsub("%s+$", "")
    local modifier = modifiers[string.upper(value)]
    if modifier then modmask = modmask + modifier else key = value end
  end
  return modmask, key
end

local function dispatcher(kind, arg, expr)
  return { __omarkeys = true, kind = kind or "", arg = arg or "", expr = expr or "" }
end

-- Tables have to round-trip: the window dispatchers take their real
-- arguments that way (resize{...}, fullscreen{...}), and flattening them
-- to nil produces an expression that dispatches "ok" and does nothing.
local function lua_literal(value)
  local t = type(value)
  if t == "string" then return string.format("%q", value) end
  if t == "number" or t == "boolean" then return tostring(value) end
  if t ~= "table" then return "nil" end
  local parts = {}
  local length = #value
  for index = 1, length do
    parts[#parts + 1] = lua_literal(value[index])
  end
  local keys = {}
  for key in pairs(value) do
    if not (type(key) == "number" and key >= 1 and key <= length and math.floor(key) == key) then
      keys[#keys + 1] = key
    end
  end
  table.sort(keys, function(left, right) return tostring(left) < tostring(right) end)
  for _, key in ipairs(keys) do
    local prefix
    if type(key) == "string" and key:match("^[%a_][%w_]*$") then
      prefix = key .. " = "
    else
      prefix = "[" .. lua_literal(key) .. "] = "
    end
    parts[#parts + 1] = prefix .. lua_literal(value[key])
  end
  return "{ " .. table.concat(parts, ", ") .. " }"
end

local function dsp_proxy(path)
  return setmetatable({ path = path }, {
    __index = function(self, key) return dsp_proxy(self.path .. "." .. tostring(key)) end,
    __call = function(self, ...)
      local first = ...
      local args = {}
      for i = 1, select("#", ...) do args[i] = lua_literal(select(i, ...)) end
      local expr = self.path .. "(" .. table.concat(args, ", ") .. ")"
      if self.path == "hl.dsp.exec_cmd" and type(first) == "string" then
        return dispatcher("exec", first, expr)
      end
      return dispatcher("lua", expr, expr)
    end,
  })
end

local noop
noop = setmetatable({}, {
  __index = function() return noop end,
  __call = function() return noop end,
})

hl = setmetatable({
  dsp = dsp_proxy("hl.dsp"),
  bind = function(keys, bind_dispatcher, opts)
    opts = type(opts) == "table" and opts or {}
    if opts.description and opts.description ~= "" then
      local modmask, key = split_keys(keys)
      local kind, arg = "", ""
      if type(bind_dispatcher) == "table" and bind_dispatcher.__omarkeys then
        kind = bind_dispatcher.kind or ""
        arg = bind_dispatcher.arg or bind_dispatcher.expr or ""
      elseif type(bind_dispatcher) == "string" and bind_dispatcher ~= "" then
        kind, arg = "exec", bind_dispatcher
      end
      print(table.concat({ tostring(modmask), opts.description, key, kind, arg }, "\t"))
    end
    return noop
  end,
  get_config = function() return nil end,
}, { __index = function() return noop end })

local config = os.getenv("HOME") .. "/.config/hypr/hyprland.lua"
local file = io.open(config, "r")
if file then
  file:close()
  pcall(dofile, config)
end
"""


def load_lua_actions() -> dict[str, list[dict]]:
    """description -> [{modmask, key, dispatcher, arg}] recovered from the config."""
    if not shutil.which("lua"):
        return {}
    try:
        proc = subprocess.run(
            ["lua", "-"], input=LUA_SCAN, text=True,
            capture_output=True, check=False, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {}
    if proc.returncode != 0:
        return {}
    by_desc: dict[str, list[dict]] = {}
    for line in proc.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 5:
            continue
        modmask, desc, key, kind, arg = parts
        if not desc or not kind:
            continue
        try:
            mask = int(modmask)
        except ValueError:
            continue
        by_desc.setdefault(desc, []).append(
            {"modmask": mask, "key": key, "dispatcher": kind, "arg": arg}
        )
    return by_desc


def pick_action(entries: list[dict], modmask: int | None, key: str) -> dict | None:
    """Prefer the entry matching this exact chord; fall back to the description."""
    if not entries:
        return None
    if modmask is None:
        # Hyprland reported no chord for this bind (keycode binds come back
        # with key "" and keycode 0). The description is then the only
        # handle we have, so accept it when it is unambiguous and decline
        # when it is not - attaching the wrong action is worse than dimming.
        return entries[0] if len(entries) == 1 else None
    upper = (key or "").upper()
    for entry in entries:
        if entry["modmask"] == modmask and entry["key"].upper() == upper:
            return entry
    # Hyprland resolves `code:NNN` binds to symbols, so the key can differ
    # from what the config wrote; modmask alone still disambiguates most.
    for entry in entries:
        if entry["modmask"] == modmask:
            return entry
    return entries[0]


def attach_hypr_keys(
    rows: list[dict],
    binds: dict[str, list[dict]],
    actions: dict[str, list[dict]] | None = None,
) -> None:
    actions = actions or {}
    for row in rows:
        opts = binds.get(row["action"]) or []
        modmask: int | None = None
        bind_key = ""
        if opts:
            row["mods"] = opts[0]["mods"]
            row["bindKey"] = opts[0]["bindKey"]
            modmask = opts[0].get("modmask", 0)
            bind_key = opts[0]["bindKey"]
        # Keep looking for the action even with no chord from hyprctl:
        # keycode binds (the whole Resize group) report an empty key, and
        # gating the action on the chord left them permanently inert.
        action = pick_action(actions.get(row["action"]) or [], modmask, bind_key)
        # Without this the overlay can only replay the chord as a synthetic
        # key, which Hyprland's bind matcher never sees.
        if action:
            row["dispatcher"] = action["dispatcher"]
            row["arg"] = action["arg"]

    # A Hyprland bind with no recovered action cannot be issued from the
    # overlay at all: chord replay is a no-op against the bind matcher, so
    # it would close the overlay and appear to do nothing. Mark those so
    # the UI dims them instead of promising something it cannot deliver.
    # OmarKEYS' own bind lands here too, which is what we want - toggling
    # the overlay from inside the overlay is meaningless.
    for row in rows:
        if not row.get("dispatcher"):
            row["runnable"] = False


def parse_print(text: str) -> list[dict]:
    rows = []
    for line in text.splitlines():
        if "→" not in line:
            continue
        left, right = line.split("→", 1)
        keys = pretty_keys(left.strip())
        action = right.strip()
        if not keys or not action:
            continue
        rows.append({"keys": keys, "action": action})
    return rows


def section_for(action: str) -> str:
    low = action.lower().strip()
    if low in START_EXACT or low.startswith("browser") or low.startswith("file manager"):
        return "Main"
    if low == "x" or low.startswith("x "):
        return "Apps"
    for title, needles in SECTION_RULES:
        for needle in needles:
            if needle in low:
                if title == "Main" and low not in START_EXACT and not low.startswith("browser") and not low.startswith("file manager"):
                    continue
                if title == "Focus and move" and any(
                    word in low for word in ("workspace", "group", "scratchpad")
                ):
                    continue
                if title == "Bar panels" and "menu" in low:
                    continue
                if title == "Media and hardware" and needle == "play" and "display" in low:
                    continue
                return title
    return "Other"


def collapse_numbered(rows: list[dict]) -> list[dict]:
    pattern = re.compile(
        r"^(?P<label>Switch to workspace|Move window to workspace|Move window silently to workspace|Bar panel|Switch to group window)\s+(?P<n>\d+)$"
    )
    groups: dict[tuple[str, str], list[tuple[int, dict]]] = {}
    passthrough: list[dict] = []
    order: list[tuple[str, str] | None] = []

    for row in rows:
        match = pattern.match(row["action"])
        if not match:
            passthrough.append(row)
            order.append(None)
            continue
        mods = row["keys"].rsplit(" + ", 1)[0] if " + " in row["keys"] else ""
        key = (mods, match.group("label"))
        if key not in groups:
            groups[key] = []
            order.append(key)
        else:
            order.append("skip")
        groups[key].append((int(match.group("n")), row))

    out: list[dict] = []
    used = set()
    p = 0
    for item in order:
        if item == "skip":
            continue
        if item is None:
            out.append(passthrough[p])
            p += 1
            continue
        if item in used:
            continue
        used.add(item)
        nums = sorted(n for n, _ in groups[item])
        mods, label = item
        if nums == list(range(1, 11)):
            keys = f"{mods} + 1-9, 0" if mods else "1-9, 0"
            action = f"{label} 1-10"
        elif nums == list(range(1, 10)):
            keys = f"{mods} + 1-9" if mods else "1-9"
            action = f"{label} 1-9"
        elif nums == list(range(1, 6)):
            keys = f"{mods} + 1-5" if mods else "1-5"
            action = f"{label} 1-5"
        else:
            # Incomplete sequences stay as individual rows. Keep the dump's
            # dispatcher/arg so Enter can still issue them.
            for _, original in sorted(groups[item], key=lambda t: t[0]):
                out.append(original)
            continue
        # Collapsed ranges are descriptive, not runnable.
        out.append({"keys": keys, "action": action})
    return out


def group(rows: list[dict]) -> list[dict]:
    buckets: dict[str, list[dict]] = {}
    titles = [title for title, _ in SECTION_RULES] + ["Other"]
    for title in titles:
        buckets[title] = []
    for row in rows:
        buckets[section_for(row["action"])].append(row)
    sections = []
    for title in titles:
        collapsed = collapse_numbered(buckets[title])
        if collapsed:
            sections.append({"title": title, "rows": collapsed})
    return sections


SHEETS_DIR = Path(__file__).resolve().parent / "sheets"


def sheet_for(cls: str) -> str | None:
    low = cls.lower()
    exact = SHEETS_DIR / f"{cls}.json"
    if exact.exists():
        return exact.name
    if SHEETS_DIR.is_dir():
        for path in SHEETS_DIR.glob("*.json"):
            try:
                meta = json.loads(path.read_text())
            except (OSError, json.JSONDecodeError):
                continue
            aliases = [str(a).lower() for a in (meta.get("classes") or [path.stem])]
            if any(alias == low or alias in low or low.startswith(alias) for alias in aliases):
                return path.name
    if "ghostty" in low:
        return "com.mitchellh.ghostty.json"
    if "chrom" in low:
        return "chromium.json"
    if "nautilus" in low:
        return "org.gnome.Nautilus.json"
    return None


def app_name_from_title(title: str) -> str:
    """The app's own name out of a window title.

    Chrome-style titles put it last ("<page> - <App>", "<page> | <App>"),
    and a PWA whose title is just its name has no separator at all.
    """
    parts = [p.strip() for p in re.split(r" [-|—] ", title or "") if p.strip()]
    return parts[-1] if parts else ""


def sheet_kind(sheet: str | None) -> str:
    """What family of app this sheet covers, for grouping the app list.

    Apps sharing a sheet share their keybindings, so the sheet is the
    honest grouping key - every Chrome PWA is one "Web app" because they
    all answer to Chromium's shortcuts.
    """
    if not sheet:
        return "No keymap sheet"
    try:
        meta = json.loads((SHEETS_DIR / sheet).read_text())
    except (OSError, json.JSONDecodeError):
        return "No keymap sheet"
    return str(meta.get("kind") or meta.get("title") or "").strip() or "No keymap sheet"


def client_label(cls: str, sheet: str | None, title: str = "") -> str:
    # A Chrome PWA's class is a 32-character extension id, which tells a
    # human nothing ("Chromium · fmpnliohjhemenmnlpbf"). The window title
    # carries the real name, so prefer it and keep the class as the fallback.
    if cls.startswith("chrome-") and cls.lower() != "chromium":
        slug = cls[7:].split("__")[0].replace("-Default", "")
        name = app_name_from_title(title)
        if name:
            return name[:24]
        if slug and slug.lower() != "chromium":
            return slug[:24]
    if sheet:
        try:
            meta = json.loads((SHEETS_DIR / sheet).read_text())
            sheet_title = str(meta.get("title") or "").strip()
        except (OSError, json.JSONDecodeError):
            sheet_title = ""
        if sheet_title:
            return sheet_title
    if cls.startswith("chrome-"):
        return cls[7:].split("__")[0][:24] or "Chromium"
    if "." in cls:
        return cls.rsplit(".", 1)[-1]
    return cls


SHELL_NAMES = {"bash", "zsh", "fish", "sh", "dash", "ksh", "tcsh"}


def process_parents() -> dict[int, int]:
    """pid -> ppid for every process, read once per dump."""
    parents: dict[int, int] = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/status") as handle:
                for line in handle:
                    if line.startswith("PPid:"):
                        parents[int(entry)] = int(line.split()[1])
                        break
        except OSError:
            continue
    return parents


def foreground_exe(pid: int) -> str:
    """What a shell is actually running, via its terminal's foreground pgid.

    Field 8 of /proc/<pid>/stat is tpgid, the foreground process group of
    the controlling terminal; the group leader's pid equals it, so its
    comm names the running program. Returns "" for an idle shell.
    """
    try:
        with open(f"/proc/{pid}/stat") as handle:
            fields = handle.read().rsplit(") ", 1)[-1].split()
        tpgid = int(fields[5])
        if tpgid <= 0 or tpgid == pid:
            return ""
        with open(f"/proc/{tpgid}/comm") as handle:
            name = handle.read().strip()
    except (OSError, ValueError, IndexError):
        return ""
    return "" if name in SHELL_NAMES else name


def shell_sessions(pid: int, parents: dict[int, int]) -> list[dict]:
    """Shells running under a terminal process, with cwd and foreground exe."""
    sessions = []
    for child, parent in parents.items():
        if parent != pid:
            continue
        try:
            with open(f"/proc/{child}/comm") as handle:
                comm = handle.read().strip()
        except OSError:
            continue
        if comm not in SHELL_NAMES:
            continue
        try:
            cwd = os.readlink(f"/proc/{child}/cwd")
        except OSError:
            cwd = ""
        sessions.append({"cwd": cwd, "exe": foreground_exe(child)})
    return sessions


def attach_sessions(windows: list[dict], sessions: list[dict]) -> None:
    """Attribute each shell to a window.

    A terminal that multiplexes windows reports one pid for all of them, so
    Hyprland cannot say which window runs what. The window title usually
    carries the shell's cwd, which pairs most of them; whatever is left is
    matched only when exactly one window and one shell remain, where the
    answer is forced. Anything still ambiguous is left blank rather than
    guessed.
    """
    home = os.environ.get("HOME", "")
    free = list(sessions)
    for window in windows:
        title = window.get("title") or ""
        expanded = title.replace("~", home, 1) if title.startswith("~") else title
        for session in list(free):
            if session["cwd"] and session["cwd"] == expanded:
                window["exe"] = session["exe"]
                free.remove(session)
                break
    unmatched = [w for w in windows if "exe" not in w]
    if len(unmatched) == 1 and len(free) == 1:
        unmatched[0]["exe"] = free[0]["exe"]


def dump_clients() -> list[dict]:
    try:
        clients = json.loads(subprocess.check_output(["hyprctl", "-j", "clients"], text=True))
    except (OSError, json.JSONDecodeError, subprocess.CalledProcessError):
        return []
    grouped: dict[str, dict] = {}
    parents = process_parents()
    for client in clients:
        cls = str(client.get("class") or "unknown").strip() or "unknown"
        title = str(client.get("title") or cls)
        focused = bool(client.get("focusHistoryID") == 0) or bool(client.get("mapped") and client.get("focused"))
        # Hyprland marks the focused window with focusHistoryID 0.
        address = str(client.get("address") or "")
        entry = grouped.get(cls)
        if not entry:
            sheet = sheet_for(cls)
            grouped[cls] = {
                "class": cls,
                "label": client_label(cls, sheet, title),
                "title": title,
                "focused": focused,
                "count": 1,
                "sheet": sheet,
                "kind": sheet_kind(sheet),
                "pid": int(client.get("pid") or 0),
                # One row per window: a terminal with two windows is two
                # things you might want to reach, not one with a count.
                "windows": [],
                # Lets the overlay send keys back to the exact window that
                # was focused when it opened, rather than whatever is
                # active by the time the chord is replayed.
                "address": address,
            }
        else:
            entry["count"] += 1
            entry["focused"] = entry["focused"] or focused
            if focused:
                entry["title"] = title
                entry["address"] = address
                entry["label"] = client_label(cls, entry["sheet"], title)
        grouped[cls]["windows"].append(
            {"address": address, "title": title, "focused": focused}
        )
    for entry in grouped.values():
        if len(entry["windows"]) > 1 or entry["pid"]:
            attach_sessions(entry["windows"], shell_sessions(entry["pid"], parents))
        for window in entry["windows"]:
            window.setdefault("exe", "")
    return sorted(grouped.values(), key=lambda c: (not c["focused"], c["label"].lower()))


def dump() -> dict:
    proc = subprocess.run(
        ["omarchy-menu-keybindings", "--print"],
        check=False,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise SystemExit(proc.stderr or "omarchy-menu-keybindings --print failed")
    rows = parse_print(proc.stdout)
    attach_hypr_keys(rows, load_hypr_binds(), load_lua_actions())
    sections = group(rows)
    digest = hashlib.sha256(
        json.dumps(sections, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()[:16]
    return {"sections": sections, "clients": dump_clients(), "hash": digest}


def main() -> None:
    json.dump(dump(), sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
